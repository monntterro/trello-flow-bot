### Postgres
POSTGRES_PASSWORD=replace_with_your_password
POSTGRES_USER=replace_with_your_user
POSTGRES_DB=postgresdb
POSTGRES_PORT=5433
POSTGRES_HOST=localhost

### Spring
JPA_IS_SHOW_SQL=true
# Encryption key and salt for secured data storaging
ENCRYPTION_KEY=replace_with_your_key
ENCRYPTION_SALT=replace_with_your_salt

### Flyway
FLYWAY_SCHEMA=public

### Telegram
# Bot token for Telegram bot
BOT_TOKEN=replace_with_your_bot_token

### App
# Application public url
APP_URL=https://example.com
APP_PORT=8080

### Trello
TRELLO_API_KEY=replace_with_your_key
TRELLO_API_SECRET=replace_with_your_secret

### Custom configurations
# It is responsible for how long the button remains active in the bot. After this time, the button
# will become inactive. We recommend setting it to about 15 minutes to avoid overloading the cache
BOT_CALLBACK_EXPIRATION_MINUTES=15

# It is responsible for determining the time period after which the bot will send repeated
# notifications about updates
TRELLO_UPDATE_REMIND_AFTER_MINUTES=30